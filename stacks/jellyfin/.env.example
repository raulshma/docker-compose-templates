# Copy to .env and fill in: cp .env.example .env

# REQUIRED — password for the admin user the setup container creates on first boot.
# Local-only stack, but don't reuse a real password.
JELLYFIN_ADMIN_PASS=

# Optional — admin username (defaults to admin)
# JELLYFIN_ADMIN_USER=admin

# Optional — media library location (defaults to ./media next to docker-compose.yml).
# Can be an absolute path anywhere on the host.
# MEDIA_DIR=D:/media/movies

# Optional — local plugin development: mounted to /config/plugins, pick up a
# plugin build output by restarting the container
# PLUGINS_DIR=

# Optional — URL advertised for LAN/DLNA discovery (defaults to http://localhost:8096)
# JELLYFIN_PUBLISHED_URL=http://localhost:8096
